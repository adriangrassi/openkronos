{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "nodenext",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["src"]
}
