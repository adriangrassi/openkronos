{
  "name": "openkronos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/gen-params.ts && node scripts/gen-effects.ts && node scripts/gen-help.ts && node tools/gen-param-docs.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "main": "out/main/index.js",
  "description": "Open-source editor and librarian for the Korg Kronos",
  "author": "Adrian Grassi",
  "homepage": "https://github.com/adriangrassi/openkronos",
  "build": {
    "appId": "io.github.adriangrassi.openkronos",
    "productName": "OpenKronos",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "OpenKronos-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OpenKronos-${version}-Setup.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "artifactName": "OpenKronos-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "OpenKronos-${version}-mac-${arch}.dmg"
    }
  }
}
